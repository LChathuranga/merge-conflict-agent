# Which provider to use: openai | anthropic | ollama
# Must stay env-configurable — never hardcoded in any source file.
PROVIDER=openai

# Model name is just a config value too — swap it any time without touching code.
LLM_MODEL=gpt-4o-mini

# One key field. Only the key for whichever PROVIDER you selected above is needed —
# paste an OpenAI key if PROVIDER=openai, or an Anthropic key if PROVIDER=anthropic.
API_KEY=

# Optional. Only used with PROVIDER=openai. Leave blank to call OpenAI's real servers.
# Set this to point the SAME adapter at any OpenAI-compatible endpoint instead, e.g.:
#   Ollama (local, free):  http://localhost:11434/v1   (API_KEY can be any non-empty string)
#   Groq (cloud, free):    https://api.groq.com/openai/v1
BASE_URL=

# --- Local Ollama example (uncomment to use) ---
# No API_KEY needed. BASE_URL defaults to http://localhost:11434/v1.
# PROVIDER=ollama
# LLM_MODEL=llama3
